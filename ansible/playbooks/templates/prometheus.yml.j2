global:
  scrape_interval: {{ prometheus_scrape_interval }}

scrape_configs:
  - job_name: 'node_exporter'
    static_configs:
{% for host in groups['all'] %}
      - targets:
          - "{{ hostvars[host].ansible_host }}:9100"
        labels:
          host: "{{ host }}"
{% endfor %}


rule_files:
  - "/etc/prometheus/rules/*.rules.yml"

alerting:
  alertmanagers:
    - static_configs:
        - targets: 
          - "alertmanager:9093"